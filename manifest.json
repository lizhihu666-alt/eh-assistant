{
  "manifest_version": 3,
  "name": "EH Assistant",
  "description": "Read-only daily todo summary for Engage Hub.",
  "version": "0.35.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite",
    "sidePanel",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://admin.engagehub.tsostech.com/*",
    "https://engagehub.tsostech.com/*",
    "https://img.engagehub.tsostech.com/*",
    "https://cdn.shopify.com/*",
    "https://prodenv-merchant-public.s3.us-west-2.amazonaws.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://litellm.wangoon.cn/*"
  ],
  "action": {
    "default_title": "打开 EH Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.engagehub.tsostech.com/*",
        "https://engagehub.tsostech.com/*"
      ],
      "js": [
        "shared/background-classifier.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_page": "options.html"
}
